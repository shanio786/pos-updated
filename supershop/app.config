<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings>
    <add name="supershop.Properties.Settings.APOSSQLConnectionString"
      connectionString="Data Source=.\SQLEXPRESS;Initial Catalog=APOSDB;Integrated Security=True;"
      providerName="System.Data.SqlClient" />
  </connectionStrings>
  <appSettings>
    <!-- Automatic daily database backup -->
    <add key="AutoBackup" value="true" />
    <!-- Put a Google Drive / OneDrive synced folder here for free cloud backup.
         The SQL Server service must be able to write to this folder. -->
    <add key="BackupFolder" value="" />
    <add key="BackupRetentionDays" value="30" />
    <!-- Fast receipt printing (drawn directly, no ReportViewer). -->
    <add key="FastReceipt" value="true" />
    <add key="ReceiptWidthMm" value="80" />
    <add key="ReceiptPreview" value="false" />
    <!-- Low-stock reminder: items at or below this quantity are flagged at login. -->
    <add key="LowStockThreshold" value="10" />
    <!-- Modern flat menu/status-bar theme. Set false for the classic look. -->
    <add key="ModernTheme" value="true" />
    <!-- Weighing-scale barcodes (price/weight embedded). Off by default. -->
    <add key="WeightBarcode.Enabled" value="false" />
    <add key="WeightBarcode.Prefix" value="2" />
    <add key="WeightBarcode.ItemDigits" value="5" />
    <add key="WeightBarcode.ValueDigits" value="5" />
    <add key="WeightBarcode.Mode" value="price" />
    <add key="WeightBarcode.PriceDivisor" value="100" />
    <add key="WeightBarcode.WeightDivisor" value="1000" />
  </appSettings>
  <startup useLegacyV2RuntimeActivationPolicy="true">
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
</configuration>